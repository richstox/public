Bottom:4},riskScaleMarkerPlaceholder:{width:8,height:8,marginBottom:4},riskScaleSegment:{width:'100%',height:8,borderRadius:999},riskScaleLabels:{marginTop:8,flexDirection:'row',gap:6},riskScaleLabelGroup:{flex:1,alignItems:'center'},riskScaleLabel:{textAlign:'center',color:y.BRAND_COLORS.textMuted,fontSize:11,textTransform:'uppercase',letterSpacing:.6},riskScaleLabelActive:{color:y.BRAND_COLORS.text,fontWeight:'600'},riskScaleRange:{textAlign:'center',color:y.BRAND_COLORS.textMuted,fontSize:10,marginTop:1},riskScaleRangeActive:{color:y.BRAND_COLORS.text,fontWeight:'500'},gotItButton:{backgroundColor:'#111827',paddingVertical:14,borderRadius:10,alignItems:'center'},gotItText:{color:'#FFFFFF',fontSize:16,fontWeight:'600'}});function T(e,t,o,n,s,l){const h=l(o),c=l(n),u=`**${t}**`,p=`**${s} median**`;switch(e){case'pe_ttm':return`${u} trades at **${h}**, compared to the ${p} of ${c}.`;case'peg_ratio':return`${u} has a PEG of **${h}**, vs. the ${p} of ${c}.`;case'net_margin_ttm':return`${u} earns **${h} net margin**, vs. the ${p} of ${c}.`;case'fcf_yield':return`${u} yields **${h}** in free cash, vs. the ${p} of ${c}.`;case'net_debt_ebitda':return`${u} has **${h} Net Debt/EBITDA**, vs. the ${p} of ${c}.`;case'revenue_growth_3y':return`${u} grew revenue at **${h} per year**, vs. the ${p} of ${c}.`;case'pb_ratio':return`${u} trades at **${h} book value**, vs. the ${p} of ${c}.`;case'ps_ratio':return`${u} trades at **${h} revenue**, vs. the ${p} of ${c}.`;case'ev_ebitda':return`${u} trades at **${h} EBITDA**, vs. the ${p} of ${c}.`;case'roe_ttm':return`${u} generates **${h}** return on equity, vs. the ${p} of ${c}.`}}function R(e,t,o){const n=['pe_ttm','peg_ratio','net_debt_ebitda','pb_ratio','ps_ratio','ev_ebitda'].includes(e),s=Math.abs(t-o)/Math.max(Math.abs(o),1e-4)<.02,l=n?t<o:t>o;if(['pe_ttm','peg_ratio','pb_ratio','ps_ratio','ev_ebitda'].includes(e)&&0!==o){const e=(100*Math.abs((t-o)/o)).toFixed(1);return s?'The stock is priced exactly in line with its peers.':t>o?`The market is charging a ${e}% premium for this stock compared to its peers.`:`The stock is trading at a ${e}% discount compared to its peers, suggesting a potential value opportunity.`}switch(e){case'pe_ttm':return s?'The stock is trading roughly in line with its peer group.':l?'The stock is priced cheaper than its peers \\u2014 suggesting a potential value opportunity.':'The market is charging a premium for this stock above what peers typically command.';case'peg_ratio':return s?'Growth-adjusted valuation is roughly in line with peers.':l&&t<1?'Below 1.0 and cheaper than peers \\u2014 a potentially undervalued growth story.':l?'Better growth-adjusted value than most peers in this group.':'Paying more for growth than peers \\u2014 justified only if the company outgrows expectations.';case'net_margin_ttm':return t<0?'Currently unprofitable \\u2014 losing money on each dollar of revenue. Watch for a path to profitability.':s?'Margins are roughly in line with industry peers.':l?'More profitable than most peers \\u2014 an efficient, well-run operation.':'Thinner margins than peers. Tight, but margin improvement is a powerful growth catalyst.';case'fcf_yield':return t<0?'Currently burning cash \\u2014 spending more than it earns. A key risk to monitor.':s?'Cash generation is roughly in line with peers.':l?'Generating more free cash relative to its price than most peers \\u2014 a cash machine.':'Below-average free cash generation compared to peers. Room to improve capital efficiency.';case'net_debt_ebitda':return t<0?'Negative value means a **net cash position** \\u2014 the company holds more cash than debt. Fortress balance sheet.':s?'Leverage is roughly in line with industry peers.':l?'Less indebted than most peers \\u2014 a healthy balance sheet with room to maneuver.':t>4?`High leverage at ${(0,u.toEU)(t,1)}x. It would take many years of earnings to clear the debt.`:'More leveraged than peers \\u2014 watch for rising interest costs if conditions tighten.';case'revenue_growth_3y':return t<0?'Revenue is shrinking \\u2014 the business is contracting. Look for what\\'s driving the decline.':s?'Growing at roughly the same pace as the peer group.':l?'Growing faster than most peers \\u2014 gaining share or expanding into new opportunities.':'Growing slower than industry peers \\u2014 may signal a maturing business or competitive pressure.';case'pb_ratio':return s?'Trading at a price-to-book multiple roughly in line with peers.':l?'Trading closer to book value than peers \\u2014 a lower premium over net assets.':'Paying a steeper premium over assets than typical peers \\u2014 only justified by strong returns on equity.';case'ps_ratio':return s?'Price-to-sales multiple is roughly in line with peers.':l?'Lower price-to-sales than peers \\u2014 relatively cheaper on a revenue basis.':'Priced higher relative to revenue than most peers \\u2014 the market expects strong margins or growth.';case'ev_ebitda':return s?'Trading at an EV/EBITDA multiple roughly in line with peers.':l?'Cheaper on an operating earnings basis than peers \\u2014 potentially overlooked by the market.':'Premium multiple on operating earnings \\u2014 the market expects strong growth or exceptional quality.';case'roe_ttm':return t<0?'Negative ROE \\u2014 currently losing money relative to shareholder equity.':s?'Generating returns on equity roughly in line with peers.':l?'More efficient at generating profit from equity than most peers \\u2014 a well-run business.':'Below-average returns on equity compared to peers. Look for what\\'s holding profitability back.'}}function _(e,t,o,n){const s=n(o),l=`**${t}**`;switch(e){case'pe_ttm':return`${l} currently trades at **${s}**. No peer benchmark is available for this group.`;case'peg_ratio':return`${l} has a PEG ratio of **${s}**. No peer benchmark available.`;case'net_margin_ttm':return`${l} earns **${s} net margin**. No peer benchmark available.`;case'fcf_yield':return`${l} yields **${s}** in free cash. No peer benchmark available.`;case'net_debt_ebitda':return o<0?`${l} is in a **net cash position** (${s}) \\u2014 holds more cash than debt.`:`${l} has **${s} Net Debt/EBITDA**. No peer benchmark available.`;case'revenue_growth_3y':return`${l} grew revenue at **${s} per year** over 3 years. No peer benchmark available.`;case'pb_ratio':return`${l} trades at **${s} book value**. No peer benchmark available.`;case'ps_ratio':return`${l} trades at **${s} revenue**. No peer benchmark available.`;case'ev_ebitda':return`${l} trades at **${s} EBITDA**. No peer benchmark available.`;case'roe_ttm':return`${l} generates **${s}** return on equity. No peer benchmark available.`;default:return null}}function x(e){return{title:\"Reward\",body:`${e} \\u2014 period {start_date} \\u2192 {end_date} ({years} years). Summary of total gain and annualised growth rate.`,howToRead:\"The hero number is the annualised CAGR. The total return for the selected period is displayed directly above the panels.\"}}function C(e){return{title:\"Avg. per Year (CAGR)\",body:`${e} grew at {cagr_pct} per year on average from {start_date} to {end_date} ({years} years). Computed as Compound Annual Growth Rate (CAGR).`,howToRead:\"CAGR smooths out good and bad years into one number. \\u26a0\\ufe0f If the period is shorter than 1 year, this annualized figure is highly volatile and should be read with caution.\"}}function A(e,t,o){return{title:\"Reward / Risk (Calmar Ratio)\",body:`${e} Calmar Ratio for {start_date} \\u2192 {end_date}: annualized return ({cagr_pct}) divided by maximum drawdown ({max_dd_pct}). Result: {calmar_ratio}.`,howToRead:`For every 1% of maximum drawdown risk taken, ${t} earned {calmar_ratio}% annual return. ${o}: 0.2\\u20130.5. Above 1.0 = strong. \\u26a0\\ufe0f For periods under 1 year, this figure is based on annualized CAGR and should be read with caution.`}}function S(e){return{title:\"Risk\",body:`Worst peak-to-trough decline for ${e} during {start_date} \\u2192 {end_date}, and how long it took to recover.`,howToRead:\"Smaller drawdown and shorter recovery = lower risk. These two numbers together describe the full pain story.\"}}function E(e,t){return{title:\"Max. Drawdown\",body:`Largest decline during the selected period:\\n\\u2022 Drawdown: {max_dd_pct}\\n\\u2022 Peak to Trough: {peak_date} \\u2192 {trough_date}\\n\\u2022 Recovered: {recovery_date}{recovery_duration}\\n\\nAll-Time Context:\\n\\u2022 ${e}`,howToRead:`A {max_dd_pct} drawdown means $100 dropped to \\${dd_floor}. The closer to 0%, the less volatile the ${t}.`}}function P(e){return{title:\"Max DD Duration\",body:`It took {duration_days} for ${e} to travel from its peak ({peak_date}) to the trough ({trough_date}) of its worst drawdown in this period.`,howToRead:\"This measures only the decline phase, not the recovery. Shorter = faster capitulation. Longer = a prolonged bear market.\"}}const D={rrr:{title:\"Risk/Reward Ratio\",body:\"Upside potential divided by downside risk. Higher = better risk-adjusted returns.\",howToRead:\"Above 1.0 = upside exceeds downside. Below 1.0 = downside risk is larger.\"},marketCap:{title:\"Market Cap\",body:\"Total value of all shares at today's price. Indicates company size.\",howToRead:\"Higher = larger company. No inherent good or bad.\"},peTtm:{title:\"P/E (TTM)\",body:\"How much you're paying for $1 of this company's annual profit.\",howToRead:\"Lower values typically mean a cheaper valuation. A very high P/E may signal high growth expectations or an overpriced stock.\"},pegRatio:{title:\"PEG Ratio\",body:\"P/E ratio divided by earnings growth \\u2014 balances price against growth expectations.\",howToRead:\"Around 1.0 is often considered balanced. Below 1.0 may suggest better growth-adjusted value. Above 2.0 could indicate expensive growth expectations.\"},pbRatio:{title:\"P/B Ratio\",body:\"How much you're paying per dollar of the company's accounting net assets.\",howToRead:\"Lower = trading closer to book value. Higher = paying a premium above net assets \\u2014 only justified by strong returns.\"},psRatio:{title:\"P/S Ratio\",body:\"Price relative to annual revenue. Useful when a company isn't yet profitable.\",howToRead:\"Lower = cheaper relative to revenue. Useful when earnings are volatile or negative.\"},evEbitda:{title:\"EV / EBITDA\",body:\"Enterprise value divided by operating earnings \\u2014 the metric dealmakers use.\",howToRead:\"Lower = cheaper valuation on operating earnings. Higher = the market expects premium quality or growth.\"},roeTtm:{title:\"ROE (TTM)\",body:\"How efficiently the company turns shareholder equity into profit.\",howToRead:\"Higher = better returns on equity. Negative = losing money relative to equity.\"},commonStockSharesOutstanding:{title:\"Shares Outstanding\",body:\"Total number of shares currently held by all shareholders, including insiders. Used to calculate per-share metrics like EPS.\",howToRead:\"Fewer shares is better. Decreasing shares signal stock buybacks \\u2014 the company is returning capital to shareholders and increasing earnings per share. Increasing shares indicate dilution, which reduces existing shareholders' ownership stake.\"},revenue:{title:\"Revenue\",body:\"Total sales generated by the company over the period \\u2014 the top line of the income statement.\",howToRead:\"Consistent growth is a positive sign. One bad period is not necessarily an alarm. Higher is generally better.\"},net_income:{title:\"Net Income\",body:\"Profit remaining after all expenses, taxes, and interest have been deducted from revenue.\",howToRead:\"Positive = profitable. Negative = the company lost money. Trend matters more than a single period.\"},free_cash_flow:{title:\"Free Cash Flow\",body:\"Cash the business generates after capital expenditures \\u2014 the money left over to invest, pay down debt, or return to shareholders.\",howToRead:\"Positive and growing FCF is a strong sign of financial health. Negative may signal heavy investment or operating losses.\"},cash:{title:\"Cash & Equivalents\",body:\"Liquid assets on the balance sheet \\u2014 cash and short-term investments the company can access immediately.\",howToRead:\"More cash provides a safety cushion and flexibility. A growing cash balance signals improving liquidity.\"},total_debt:{title:\"Total Debt\",body:\"All interest-bearing obligations: short-term borrowings plus long-term debt on the balance sheet.\",howToRead:\"Lower is better. Rising debt increases financial risk; declining debt improves the company's financial flexibility.\"},netMargin:{title:\"Net Margin\",body:\"How many cents of profit the company keeps from every $1 of revenue.\",howToRead:\"Higher = more profit per dollar of sales. Negative = the company is losing money.\"},fcfYield:{title:\"Free Cash Flow Yield\",body:\"Cash the business generates after all costs, as a % of its market value.\",howToRead:\"Higher = more cash relative to company value. Negative = burning cash.\"},netDebtEbitda:{title:\"Net Debt / EBITDA\",body:\"How many years of operating profit it would take to pay off all net debt.\",howToRead:\"Lower = less debt burden. Negative = net cash (more cash than debt). Above 4\\xd7 is typically considered high leverage.\"},revenueGrowth:{title:\"Revenue Growth\",body:\"Average annual revenue growth over the last 3 years.\",howToRead:\"Positive = growing. Negative = shrinking. Faster growth than peers can signal competitive advantage.\"},dividendYield:{title:\"Dividend Yield\",body:\"Annual dividend per share as % of stock price. Only for dividend-paying companies.\",howToRead:\"Higher = more cash to shareholders. Zero = no dividend paid.\"},wealthGap:{title:\"Performance vs Index\",body:\"If you invested $100 in this stock vs $100 in S&P 500, how much more or less would you have today?\",howToRead:\"Positive = you would have more. Negative = you would have less. -100% = stock went to zero.\"},perfCheckReward:x('{ticker}'),perfCheckRisk:S('{ticker}'),perfCheckTotalProfit:{title:\"Total Return\",body:\"The absolute net growth of your fund, combining realized gains from closed trades and current unrealized performance of open positions.\",howToRead:\"Positive = your fund has grown above starting capital. Negative = it has declined. This is not a per-stock metric \\u2014 it reflects your entire account equity. Context only, not a guarantee of future performance.\"},perfCheckRewardTracklist:{title:\"Reward\",body:\"Your fund \\u2014 period {start_date} \\u2192 {end_date} ({years} years). Summary of total gain and annualised growth rate.\",howToRead:\"The hero number is the annualised CAGR. The total return for the selected period is displayed directly above the panels.\"},diversificationTracklist:{title:\"Diversification Score\",body:\"This score measures the fund's concentration risk based strictly on sector exposure. A higher score means a more evenly distributed fund across market sectors.\",riskScale:!0},perfCheckAvgPerYear:C('{ticker}'),perfCheckAvgPerYearTracklist:{title:\"Avg. per Year (CAGR)\",body:\"CAGR is the annualized equivalent of your return. Computed as Compound Annual Growth Rate (CAGR) from {start_date} to {end_date}.\",howToRead:\"CAGR smooths out good and bad years into one number. \\u26a0\\ufe0f Because your fund is only {period_days} days old, this annualized figure can be highly volatile and should be interpreted with caution.\"},perfCheckRewardRisk:A('{ticker}','the investor','Typical stocks'),perfCheckRewardRiskPortfolio:{title:\"Reward / Risk (Calmar Ratio)\",body:\"Portfolio Calmar Ratio for {start_date} \\u2192 {end_date}: annualized return ({cagr_pct}) divided by maximum drawdown ({max_dd_pct}). Result: {calmar_ratio}.\",howToRead:\"For every 1% of maximum drawdown risk taken, your portfolio earned {calmar_ratio}% annual return. Typical portfolios: 0.2\\u20130.5. Above 1.0 = strong. \\u26a0\\ufe0f For periods under 1 year, this figure is based on annualized CAGR and should be read with caution.\"},perfCheckRewardRiskTracklist:{title:\"Reward / Risk (Calmar Ratio)\",body:\"Fund Calmar Ratio for {start_date} \\u2192 {end_date}: annualized return ({cagr_pct}) divided by maximum drawdown ({max_dd_pct}). Result: {calmar_ratio}.\",howToRead:\"Calmar Ratio compares annualized return with maximum drawdown. Higher values indicate stronger returns relative to the worst historical drawdown. \\u26a0\\ufe0f For funds younger than 1 year, the ratio can be highly unstable because the return is annualized.\"},historicalDividendsGenerated:{title:\"\",body:\"Informational only \\u2014 already included in adjusted price, not added to profit.\"},perfCheckMaxDrawdown:E('Lifetime Max Drawdown for {ticker} is {global_max_dd_pct}.','stock'),perfCheckDuration:P('{ticker}'),perfCheckRiskPortfolio:{title:\"Max. Drawdown\",body:\"Worst peak-to-trough decline for your portfolio during {start_date} \\u2192 {end_date}, and how long it took to recover.\",howToRead:\"Smaller drawdown and shorter recovery = lower risk. These two numbers together describe the full pain story.\"},perfCheckRiskTracklist:{title:\"Max. Drawdown\",body:\"Worst peak-to-trough decline for your fund during {start_date} \\u2192 {end_date}, and how long it took to recover.\",howToRead:\"Smaller drawdown and shorter recovery = lower risk. These two numbers together describe the full pain story.\"},perfCheckDurationPortfolio:{title:\"Drawdown Duration\",body:\"Peak-to-Trough Time. It took {days} days for your portfolio to drop from its highest peak to the lowest trough during the maximum drawdown.\",howToRead:\"Measures the capitulation phase. Shorter = sudden crash. Longer = prolonged market bleed.\"},perfCheckDurationTracklist:{title:\"Drawdown Duration\",body:\"Peak-to-Trough Time. It took {days} days for your fund to drop from its highest peak to the lowest trough during the maximum drawdown.\",howToRead:\"Measures the capitulation phase. Shorter = sudden crash. Longer = prolonged market bleed.\"},perfCheckRewardMarket:x('US market benchmark'),perfCheckAvgPerYearMarket:C('US market benchmark'),perfCheckRewardRiskMarket:A('US market benchmark','the market','Typical markets'),perfCheckRiskMarket:S('the US market benchmark'),perfCheckMaxDrawdownMarket:E('Lifetime Max Drawdown is {global_max_dd_pct}.','market'),perfCheckDurationMarket:P('the US market benchmark'),perfCheckRecovered:{title:\"Recovered\",body:\"{ticker} climbed back above its pre-drawdown peak on {recovery_date} \\u2014 {recovery_days} days after hitting the trough on {trough_date}.\",howToRead:\"'Not yet' means the stock is still below its previous high within this period. A past date means the investor was made whole.\"},perfCheckIndex:{title:\"Index (S&P 500 TR)\",body:\"S&P 500 Total Return (dividends reinvested) over the same period ({start_date} \\u2192 {end_date}): {benchmark_total_pct}. {ticker} earned {outperformance_multiple} as much as the market.\",howToRead:\"A multiple above 1.0\\xd7 means the stock outperformed the index. Below 1.0\\xd7 = underperformance. Context only, not advice.\"},perfCheckVsIndex:{title:\"Vs. Index (Alpha)\",body:\"How much your fund gained or lost compared to the S&P 500 Total Return index over the same period. A positive number means your fund outperformed the market.\",howToRead:\"+5% means your fund earned 5 percentage points more than the index. Negative = underperformed. Zero = matched the market.\"},perfCheckIndexPortfolio:{title:\"Index return\",body:\"S&P 500 Total Return (dividends reinvested) over the exact same period ({start_date} \\u2192 {end_date}): {benchmark_total_pct}.\",howToRead:\"This represents the baseline market performance you could have achieved by simply investing your capital into a passive index fund.\"},perfCheckIndexTracklist:{title:\"Index return\",body:\"S&P 500 Total Return (dividends reinvested) over the exact same period ({start_date} \\u2192 {end_date}): {benchmark_total_pct}.\",howToRead:\"This represents the baseline market performance you could have achieved by simply investing your capital into a passive index fund.\"},perfCheckMultiplePortfolio:{title:\"Portfolio vs Index\",body:\"S&P 500 Total Return (dividends reinvested) over the same period ({start_date} \\u2192 {end_date}): {benchmark_total_pct}. Your portfolio earned {outperformance_multiple}\\xd7 as much as the market.\",howToRead:\"A multiple above 1.0\\xd7 means your portfolio outperformed the index. Below 1.0\\xd7 = underperformance. Context only, not advice.\"},perfCheckMultipleTracklist:{title:\"Fund vs Index\",body:\"S&P 500 Total Return (dividends reinvested) over the same period ({start_date} \\u2192 {end_date}): {benchmark_total_pct}. Your fund earned {outperformance_multiple}\\xd7 as much as the market.\",howToRead:\"A multiple above 1.0\\xd7 means your fund outperformed the index. Below 1.0\\xd7 = underperformance. Context only, not advice.\"},tracklistInceptionDate:{title:\"Inception Date\",body:\"The date your Fund started ({inception_date}) \\u2014 {duration_days} days ago. All return metrics (Reward, Avg. per Year, Drawdown, etc.) are measured from this date.\",howToRead:\"Earlier inception = longer track record. More data means the metrics are more reliable.\"},tracklistEquityValue:{title:\"Equity Value (USD)\",body:\"The current total market value of all open positions in your Fund, expressed in US dollars. It reflects the portfolio's worth at today's prices.\",howToRead:\"Higher = your portfolio has grown. Lower = it has declined. Compare to your starting capital to measure progress.\"},tracklistTodayChange:{title:\"Today's Change\",body:\"How much your Fund's equity value moved today compared to yesterday's closing value. Shown in USD or % depending on the toggle.\",howToRead:\"Positive (green) = portfolio gained today. Negative (red) = it lost value. This is a single-day move, not the total return.\"},homepageNoEventsInRange:{title:\"Events & News\",body:\"**No events in {selectedRangeLabel}.** There are no scheduled events in **{selectedRangeLabel}** for companies in your Fund, Portfolio, or Watchlist, so we switched the view to **{fallbackRangeLabel}**.\"},marketsNoEventsInRange:{title:\"Events & News\",body:\"**No events in {selectedRangeLabel}.** There are no scheduled events in **{selectedRangeLabel}**, so we switched the view to **{fallbackRangeLabel}**.\"},tracklistMaxDrawdownUsd:{title:\"Max Drawdown (USD)\",body:\"The worst peak-to-trough decline expressed in dollar terms \\u2014 the actual dollar loss from the highest point to the lowest point during the drawdown period.\",howToRead:\"A larger negative number means a bigger dollar loss at the worst point. Use this alongside the % drawdown to understand real-money impact.\"},tracklistRealizedPnl:{title:\"Realized P/L\",body:\"The actual profit or loss locked in from positions that have already been closed (sold). Once a trade is closed, the gain or loss is 'realized' and cannot change.\",howToRead:\"Positive = profitable closed trades. Negative = losses taken. This does not include open positions.\"},tracklistUnrealizedPnl:{title:\"Unrealized P/L\",body:\"The current paper gain or loss on positions that are still open. This number changes with the market every day and is only 'realized' when you close the position.\",howToRead:\"Positive = your open positions are currently in profit. Negative = they are below your entry price. Context only \\u2014 not locked in until sold.\"},tracklistCashBalance:{title:\"Cash Balance\",body:\"The uninvested cash remaining in your fund after all buy and sell trades. This is the portion of your starting capital not currently deployed in open positions.\",howToRead:\"Higher cash = more of your capital is on the sideline. Lower cash = more is invested. Neither is inherently better.\"},tracklistWinRate:{title:\"Win Rate (SELL-only)\",body:\"The percentage of closed (sold) trades that ended in profit. Only SELL transactions count \\u2014 open positions are excluded because they have no confirmed outcome yet.\",howToRead:\"75% means 3 out of every 4 closed trades were profitable. A high win rate with small gains can still underperform a lower win rate with large gains.\"},equityHistoryChart:{title:\"Equity History\",body:\"This chart shows your fund equity over time (equal-weight), not a single stock price. Each point represents the total portfolio value \\u2014 or percentage return \\u2014 on that trading day.\",howToRead:\"Switch % / USD to change the view between percentage return and dollar value. The chart always ends at the latest available market close.\"},earningsHeader:{title:\"Earnings & Revenue (Quarterly)\",body:\"Reported EPS and Revenue per quarter. (Est = Estimated). Green badges indicate beating analyst estimates; Red indicates missing them.\",howToRead:\"Green badge = beat. Red badge = miss. The % shows how far the actual result was from the estimate. Context only, not advice.\"},annualEarningsHeader:{title:\"Earnings & Revenue (Annual)\",body:\"Total reported EPS and Revenue for the fiscal year. YoY % growth is displayed for both metrics.\"},earningsYoY:{title:\"YoY \\u2014 Year-over-Year Change\",body:\"The percentage change in total annual reported EPS versus the previous year. A positive number means earnings per share grew; a negative number means they declined.\",howToRead:\"Green = annual EPS grew vs last year. Red = annual EPS fell. Neutral = flat or not enough comparable data. Context only, not advice.\"},earningsExpected:{title:\"Exp \\u2014 Expected (Consensus Estimate)\",body:\"Exp is short for Expected. It is the average earnings-per-share (EPS) forecast from Wall Street analysts before the company reported results. It reflects the market's best guess going in.\",howToRead:\"Compare it against Act (Actual) to see whether the company beat or missed. Context only, not advice.\"},earningsActual:{title:\"Act \\u2014 Actual (Reported EPS)\",body:\"Act is short for Actual. It is the earnings-per-share the company officially reported for that quarter. Negative numbers mean the company lost money per share that period.\",howToRead:\"Higher than Exp (Expected) = beat (green badge). Lower than Exp = miss (red badge). Negative = unprofitable that quarter. Context only, not advice.\"},earningsBeatMiss:{title:\"Beat / Miss Badge\",body:\"The coloured badge shows whether the reported EPS (Act) came in above or below the analyst estimate (Exp). Green badge = beat (company earned more than expected). Red badge = miss (company fell short). The percentage shows the size of the surprise.\",howToRead:\"+5% means the company earned 5% more than expected. -10% means 10% below the estimate. Context only, not advice.\"},earningsSurprise:{title:\"Surprise \\u2014 Earnings vs Estimate\",body:\"The percentage difference between reported EPS (Act) and the analyst estimate (Exp) for that quarter. Positive means the company beat expectations; negative means it missed.\",howToRead:\"+5% means reported EPS came in 5% above the estimate. -10% means it came in 10% below. Shown only when both actual and expected EPS are available. Context only, not advice.\"},earningsNA:{title:\"N/A \\u2014 Data Not Available\",body:\"Either the analyst estimate (Exp) or the reported figure (Act) is missing for this quarter. This can happen for very small companies, recent IPOs, or periods with no analyst coverage.\",howToRead:\"N/A in Exp means no analyst consensus existed. N/A in Act means the result was not captured. Context only, not advice.\"},earningsNoEstimate:{title:\"No Analyst Estimate Available\",body:\"No analyst estimate available for this quarter.\",howToRead:\"When Exp shows N/A or the badge shows \\u2014, analyst consensus was not available for that quarter.\"},dividendsHeader:{title:\"Dividends\",body:\"Cash payments a company makes to shareholders from its profits. Not all companies pay dividends \\u2014 many reinvest profits into growth instead.\",howToRead:\"Consistent or growing dividends can signal financial health. A cut or stop may signal stress. Context only, not advice.\"},dividendsTTM:{title:\"TTM \\u2014 Trailing Twelve Months\",body:\"The total dividend paid over the most recent 12-month period, rolling back from today. It gives a current-year snapshot even if the calendar year is not finished.\",howToRead:\"TTM updates with each new payment, so it reflects the latest dividend run-rate rather than a fixed prior year. Context only, not advice.\"},dividendsYoY:{title:\"YoY Change (Annual Dividends)\",body:\"The percentage change in total annual dividends compared to the previous full calendar year. A positive number means the company paid more; negative means less.\",howToRead:\"Green = dividend grew vs last year. Red = dividend shrank. Only shown for complete calendar years. Context only, not advice.\"},dividendsPartialYear:{title:\"Partial Year\",body:\"The current calendar year is not yet complete, so total dividends so far are less than a full year. YoY comparison is hidden to avoid misleading you with an incomplete figure.\",howToRead:\"Wait until year-end for a fair year-over-year comparison. The amount shown is just what has been paid so far this year. Context only, not advice.\"},dividendsFrequency:{title:\"Payment Frequency\",body:\"How often the company pays dividends, detected from its recent payment history. Common patterns are monthly, quarterly, semi-annual, or annual.\",howToRead:\"Frequency is auto-detected and may show 'Irregular' if the schedule is inconsistent. Context only, not advice.\"},dividendsCurrency:{title:\"Display Currency\",body:\"The currency used to show dividend amounts on this screen. It matches the stock's primary trading currency unless a conversion has been applied.\",howToRead:\"If you see a currency different from your home currency, amounts may vary with exchange rates. Context only, not advice.\"},dividendsNextDividend:{title:\"Next Dividend\",body:\"The upcoming dividend event based on scheduled ex-dividend and payment dates. If no schedule is known yet, the card shows 'No upcoming distribution'.\",howToRead:\"Owning shares on or after the ex-date means you will NOT receive the next dividend. The payment date is when cash is deposited. Context only, not advice.\"},dividendsExDate:{title:\"Ex-Date\",body:\"Ex-date is the cut-off date for dividend eligibility. To receive the dividend, you must own the stock before the ex-date.\",howToRead:\"If you buy on or after ex-date, you will not receive that dividend. Payment date is only when cash arrives.\"},dividendsYearAmount:{title:\"Year / Amount\",body:\"This annual view shows each calendar year and the total dividend amount paid in that year.\",howToRead:\"Use this column to compare full-year payout levels over time. Context only, not advice.\"},dividendsPaymentAmount:{title:\"Dividend Amount\",body:\"The cash amount paid per share for each dividend event in the payments list.\",howToRead:\"Amounts are shown in the display currency and may differ from your account currency. Context only, not advice.\"},dividendsYieldTile:{title:\"DIV. YIELD\",body:\"Annual dividend return based on the current stock price.\"},dividendsPayoutRatioTile:{title:\"PAYOUT RATIO\",body:\"Percentage of the company's earnings paid out as dividends. Lower is generally safer.\",howToRead:\"If this shows \\u2014, payout ratio cannot be calculated because EPS TTM is missing/non-positive or the latest 4 paid dividends are unavailable.\"},dividendsGrowth5yTile:{title:\"5Y GROWTH\",body:\"Average annual rate at which the dividend has grown over the last 5 years.\"},dividendsTrackRecordTile:{title:\"TRACK RECORD\",body:\"Consecutive years of paying a dividend without reducing it.\"},marketRegime:{title:\"Price vs. History\",body:\"Shows where the current price sits vs its past highs/lows (EOD closes).\\nATH = all-time high. ATL = all-time low.\\nDrawdown (DD) = % below ATH.\\nTo Max DD = % remaining drop needed to match the worst historical drawdown depth.\\nRecovery (ATH) = % needed to return to ATH.\"},chooseAnAction:{title:\"How it works\",body:\"{count} stocks \\xb7 {equity} virtual equity \\xb7 equal weight\\n\\n**What you can do here**\\n\\n**Replace a ticker** \\u2014 swap one stock for another to test your pick.\\n\\n**Rebalance** \\u2014 reset every position back to equal weight (~{equalWeight}% per stock).\\n\\nAll changes execute at the **next market close**.\"},epsEstimateRevision:{title:\"Expected Business Growth\",body:\"Shows the current consensus estimate compared to the actual reported results from the exact same period last year.\",howToRead:\"Green = Expected to grow year-over-year. Red = Expected to decline year-over-year. Gray = Historical baseline unavailable.\"},revenueEstimateRevision:{title:\"Expected Business Growth\",body:\"Shows the current consensus estimate compared to the actual reported results from the exact same period last year.\",howToRead:\"Green = Expected to grow year-over-year. Red = Expected to decline year-over-year. Gray = Historical baseline unavailable.\"}},$={perfCheckTotalProfit:{title:\"Backtest Total Return\",body:\"Historical return of your current portfolio composition based on past market data. This is a backtest, not your actual trading profit.\",howToRead:\"Positive = the projected historical result for your current holdings was higher than the backtest starting point. Negative = lower. This does not represent realized trading gains.\"},perfCheckRewardTracklist:{title:\"Backtest Total Return\",body:\"Your portfolio backtest \\u2014 period {start_date} \\u2192 {end_date} ({years} years). Summary of historical total gain and annualised growth rate.\",howToRead:\"This is based on historical reconstruction of your current holdings, not your live account P/L.\"},perfCheckAvgPerYearTracklist:{title:\"Backtest Avg. per Year (CAGR)\",body:\"CAGR is the annualized equivalent of your return. Computed as Compound Annual Growth Rate (CAGR) from {start_date} to {end_date}.\",howToRead:\"CAGR smooths out good and bad years into one number. \\u26a0\\ufe0f Because your portfolio is only {period_days} days old, this annualized figure can be highly volatile and should be interpreted with caution.\"},perfCheckRewardRiskTracklist:{title:\"Backtest Reward / Risk (Calmar Ratio)\",body:\"Portfolio Calmar Ratio for {start_date} \\u2192 {end_date}: annualized return ({cagr_pct}) divided by maximum drawdown ({max_dd_pct}). Result: {calmar_ratio}.\",howToRead:\"Calmar Ratio compares annualized return with maximum drawdown. Higher values indicate stronger returns relative to the worst historical drawdown. \\u26a0\\ufe0f For portfolios younger than 1 year, the ratio can be highly unstable because the return is annualized.\"},perfCheckRiskTracklist:{title:\"Backtest Max. Drawdown\",body:\"Worst peak-to-trough decline for your portfolio during {start_date} \\u2192 {end_date}, and how long it took to recover.\",howToRead:\"Smaller drawdown and shorter recovery = lower risk. These two numbers together describe the full pain story.\"},perfCheckMultipleTracklist:{title:\"Backtest Portfolio vs Index\",body:\"S&P 500 Total Return (dividends reinvested) over the same period ({start_date} \\u2192 {end_date}): {benchmark_total_pct}. Your portfolio's return is compared with the market to show relative performance.\",howToRead:\"A multiple above 1.0\\xd7 means your portfolio outperformed the index. Below 1.0\\xd7 means underperformance. Context only, not advice.\"},tracklistInceptionDate:{title:\"Backtest Start Date\",body:\"The date your backtest period starts ({inception_date}) \\u2014 {duration_days} days ago. Backtest Total Return, Backtest Avg. per Year, Backtest Drawdown, and other backtest metrics are measured from this date.\",howToRead:\"Earlier backtest start = longer historical sample. More data generally makes backtest metrics more stable.\"},tracklistEquityValue:{title:\"Equity Value (USD)\",body:\"The current total market value of all open positions in your portfolio, expressed in US dollars. It reflects your portfolio's worth at today's prices.\",howToRead:\"Higher = your portfolio has grown. Lower = it has declined. Compare to your starting capital to measure progress.\"},tracklistTodayChange:{title:\"Today's Change\",body:\"How much your portfolio's equity value moved today compared to yesterday's closing value. Shown in USD or % depending on the toggle.\",howToRead:\"Positive (green) = portfolio gained today. Negative (red) = it lost value. This is a single-day move, not the total return.\"},tracklistCashBalance:{title:\"Cash Balance\",body:\"The uninvested cash remaining in your portfolio after all buy and sell trades. This is the portion of your starting capital not currently deployed in open positions.\",howToRead:\"Higher cash = more of your capital is on the sideline. Lower cash = more is invested. Neither is inherently better.\"},equityHistoryChart:{title:\"Equity History\",body:\"This chart shows your portfolio value over time, not a single stock price. Each point represents the total value \\u2014 or percentage return \\u2014 of your portfolio on that trading day.\",howToRead:\"Switch % / USD to change the view between percentage return and dollar value. The chart always ends at the latest available market close.\"}};var N=b},854,[11,80,114,120,483,124,18,123,855,856,816,6,857]);\n__d(function(g,r,i,a,m,e,d){\"use strict\";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,\"toEU\",{enumerable:!0,get:function(){return n}}),Object.defineProperty(e,\"formatIntegerEU\",{enumerable:!0,get:function(){return u}}),Object.defineProperty(e,\"MAX_RECOVERY_DISPLAY_THRESHOLD\",{enumerable:!0,get:function(){return o}}),Object.defineProperty(e,\"formatPercentRoundedEU\",{enumerable:!0,get:function(){return f}}),Object.defineProperty(e,\"formatDayCountEU\",{enumerable:!0,get:function(){return l}}),Object.defineProperty(e,\"formatDurationDays\",{enumerable:!0,get:function(){return c}}),Object.defineProperty(e,\"formatCurrencyFixedEU\",{enumerable:!0,get:function(){return 